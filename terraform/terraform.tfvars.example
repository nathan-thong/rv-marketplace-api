project_id     = "your-gcp-project-id"
ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

# The defaults in variables.tf (region/zone = us-central1) are already
# Always-Free-tier eligible for the e2-micro instance. Only override them
# if you know what you're doing - the free tier for e2-micro only applies
# in us-west1, us-central1, and us-east1.
# region = "us-central1"
# zone   = "us-central1-a"

# Once you've confirmed the instance is reachable, tighten this to just
# your own IP (e.g. ["203.0.113.4/32"]) instead of leaving SSH open to
# the world.
# ssh_source_ranges = ["0.0.0.0/0"]
